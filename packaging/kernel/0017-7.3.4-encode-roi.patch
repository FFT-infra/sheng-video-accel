From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xinyang <xinyang@localhost>
Date: Wed, 19 Nov 2026 12:00:00 +0800
Subject: [PATCH] media: iris: per-macroblock ROI delta QP for the encoder (7.3.4)

The encoder cannot vary a picture's QP by region. The firmware takes the
variation as an HFI metadata buffer that carries a delta per macroblock and
is queued together with the raw input frame, and this driver neither builds
nor queues one.

Adapt the ROI series posted upstream for HFI gen2 without touching v4l2-core
or the UAPI. Upstream adds an S8 control type and a control id; this module
keeps the same id (V4L2_CID_CODEC_BASE + 658) on the dynamic s32 array type,
whose signed range and per-element validation carry the same values, so a
module-only update can register it. The control takes one delta per
macroblock in raster order over the encoder's raw OUTPUT geometry, which is
the client's request before the 128x32 alignment: 16 pixels for H.264 and 32
for HEVC. The setter narrows each value into the firmware's s16 form, bit 11
set and bits 4..9 the delta, with every row aligned to 8 LCUs, and writes it
into a metadata buffer whose header names HFI_PROP_ROI_INFO.

A map belongs to one picture. The write arms the buffer; the QBUF that
follows appends it to the same HFI command as the raw frame, under the same
index, so the firmware pairs them while several pictures are in flight. The
firmware returns it as HFI_BUFFER_METADATA, and the buffer is then reusable
for the next map. Delivery mode is a session property, subscribed once before
the first map that is armed while the queue is streaming.

A setter that cannot arm the picture now fails the control ioctl. A map that
does not match the macroblock grid, or a delivery-mode command the firmware
refused, must not leave user space believing the frame carries regions.

---
diff --git a/drivers/media/platform/qcom/iris/iris_buffer.c b/drivers/media/platform/qcom/iris/iris_buffer.c
index b03c07c..ba9c937 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_buffer.c
@@ -3,10 +3,12 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/slab.h>
 #include <media/v4l2-event.h>
 #include <media/v4l2-mem2mem.h>
 
 #include "iris_buffer.h"
+#include "iris_hfi_gen2_defines.h"
 #include "iris_instance.h"
 #include "iris_power.h"
 #include "iris_vpu_buffer.h"
@@ -707,6 +709,20 @@ int iris_destroy_dequeued_internal_buffers(struct iris_inst *inst, u32 plane)
 	return iris_destroy_internal_buffers(inst, plane, false);
 }
 
+int iris_destroy_roi_metadata_buffers(struct iris_inst *inst)
+{
+	struct iris_buffer *buf, *next;
+	struct iris_buffers *buffers;
+
+	if (inst->domain == ENCODER) {
+		buffers = &inst->buffers[BUF_ROIMB_DELTAQP];
+		list_for_each_entry_safe(buf, next, &buffers->list, list)
+			iris_destroy_internal_buffer(inst, buf);
+	}
+
+	return 0;
+}
+
 static int iris_release_internal_buffers(struct iris_inst *inst,
 					 enum iris_buffer_type buffer_type)
 {
@@ -936,3 +952,115 @@ int iris_vb2_buffer_done(struct iris_inst *inst, struct iris_buffer *buf)
 
 	return 0;
 }
+
+static u32 iris_roi_lcu_size(struct iris_inst *inst)
+{
+	return inst->codec == V4L2_PIX_FMT_HEVC ? 32 : 16;
+}
+
+/*
+ * Lay the client's per-macroblock delta QP array into the metadata buffer.
+ * The firmware wants s16 entries in a row of LCUs aligned to 8, with the
+ * delta in bits 4..9 and bit 11 set; the client's s32 array is row-major over
+ * the coded picture's LCU grid.
+ */
+static int iris_fill_roi_data(struct iris_inst *inst, struct iris_buffer *buffer)
+{
+	const s32 *p_array = inst->fw_caps[ROI_PARAMS].p_array;
+	u32 lcu_size = iris_roi_lcu_size(inst);
+	u32 lcu_width, lcu_height, row_size, array_size;
+	struct metapayload_header *payload_hdr;
+	struct metabuf_header *mbuf_hdr;
+	u32 payload_offset;
+	s16 *p16, *p_row;
+	u32 i, j;
+
+	if (!p_array)
+		return -EINVAL;
+
+	lcu_width = DIV_ROUND_UP(inst->enc_raw_width, lcu_size);
+	lcu_height = DIV_ROUND_UP(inst->enc_raw_height, lcu_size);
+	/* The firmware expects each row aligned to 8 LCUs. */
+	row_size = ALIGN(lcu_width, 8);
+	array_size = inst->fw_caps[ROI_PARAMS].elems;
+
+	/* A missed element would let the firmware read the previous frame's
+	 * values from a partly filled buffer. */
+	if (array_size != lcu_width * lcu_height)
+		return -EINVAL;
+
+	mbuf_hdr = buffer->kvaddr;
+	memset(mbuf_hdr, 0, sizeof(*mbuf_hdr) + sizeof(*payload_hdr));
+	mbuf_hdr->count = 1;
+	mbuf_hdr->size = sizeof(*mbuf_hdr) + sizeof(*payload_hdr);
+	mbuf_hdr->version = BIT(16);
+
+	payload_offset = sizeof(*mbuf_hdr) + sizeof(*payload_hdr);
+	payload_hdr = (struct metapayload_header *)((u8 *)mbuf_hdr + sizeof(*mbuf_hdr));
+	payload_hdr->type = HFI_PROP_ROI_INFO;
+	payload_hdr->version = BIT(16);
+	payload_hdr->offset = ALIGN(payload_offset, 256);
+	payload_hdr->size = row_size * lcu_height * sizeof(s16) + 256;
+
+	p16 = (s16 *)((u8 *)buffer->kvaddr + payload_hdr->offset);
+	for (j = 0; j < lcu_height; j++) {
+		p_row = p16 + j * row_size;
+		for (i = 0; i < lcu_width; i++)
+			p_row[i] = BIT(11) | ((p_array[j * lcu_width + i] & 0x3F) << 4);
+	}
+
+	return 0;
+}
+
+int iris_hfi_gen2_session_alloc_roi_metadata_buffer(struct iris_inst *inst)
+{
+	struct iris_buffers *buffers = &inst->buffers[BUF_ROIMB_DELTAQP];
+	struct iris_core *core = inst->core;
+	struct iris_buffer *buffer, *next;
+	bool found = false;
+	int ret;
+
+	if (!buffers->size)
+		return 0;
+
+	/*
+	 * The map for the next picture goes into a buffer the firmware has
+	 * finished with, or into a new one while every existing buffer is still
+	 * in flight. The chosen buffer is armed at the head of the list so
+	 * iris_queue_metadata_buffer() finds it for the QBUF that follows.
+	 */
+	list_for_each_entry_safe(buffer, next, &buffers->list, list) {
+		if (buffer->attr & BUF_ATTR_DEQUEUED) {
+			buffer->attr &= ~BUF_ATTR_DEQUEUED;
+			list_move(&buffer->list, &buffers->list);
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		buffer = kzalloc_obj(*buffer);
+		if (!buffer)
+			return -ENOMEM;
+
+		INIT_LIST_HEAD(&buffer->list);
+		buffer->type = BUF_ROIMB_DELTAQP;
+		buffer->buffer_size = buffers->size;
+		buffer->dma_attrs = DMA_ATTR_WRITE_COMBINE;
+
+		buffer->kvaddr = dma_alloc_attrs(core->dev, buffer->buffer_size,
+						 &buffer->device_addr, GFP_KERNEL,
+						 buffer->dma_attrs);
+		if (!buffer->kvaddr) {
+			kfree(buffer);
+			return -ENOMEM;
+		}
+		list_add(&buffer->list, &buffers->list);
+	}
+
+	buffer = list_first_entry(&buffers->list, struct iris_buffer, list);
+	ret = iris_fill_roi_data(inst, buffer);
+	if (ret)
+		return ret;
+
+	return 0;
+}
diff --git a/drivers/media/platform/qcom/iris/iris_buffer.h b/drivers/media/platform/qcom/iris/iris_buffer.h
index ab8e5d9..3b6086d 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.h
+++ b/drivers/media/platform/qcom/iris/iris_buffer.h
@@ -28,6 +28,7 @@ struct iris_inst;
  * @BUF_SCRATCH_2: buffer to store encoding context data for HW
  * @BUF_VPSS: buffer to store VPSS context data for HW
  * @BUF_PARTIAL: buffer for AV1 IBC data
+ * @BUF_ROIMB_DELTAQP: metadata buffer carrying the per-macroblock ROI delta QP
  * @BUF_TYPE_MAX: max buffer types
  */
 enum iris_buffer_type {
@@ -44,6 +45,7 @@ enum iris_buffer_type {
 	BUF_SCRATCH_2,
 	BUF_VPSS,
 	BUF_PARTIAL,
+	BUF_ROIMB_DELTAQP,
 	BUF_TYPE_MAX,
 };
 
@@ -122,4 +124,25 @@ int iris_queue_deferred_buffers(struct iris_inst *inst, enum iris_buffer_type bu
 int iris_vb2_buffer_done(struct iris_inst *inst, struct iris_buffer *buf);
 void iris_vb2_queue_error(struct iris_inst *inst);
 
+/* Metadata buffer header, as the firmware reads it. */
+struct metabuf_header {
+	u32 count;
+	u32 size;
+	u32 version;
+	u32 reserved[5];
+};
+
+/* Metadata buffer payload header, one per payload in the buffer. */
+struct metapayload_header {
+	u32 type;
+	u32 size;
+	u32 version;
+	u32 offset;
+	u32 flags;
+	u32 reserved[3];
+};
+
+int iris_hfi_gen2_session_alloc_roi_metadata_buffer(struct iris_inst *inst);
+int iris_destroy_roi_metadata_buffers(struct iris_inst *inst);
+
 #endif
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index bf97101..0c111b7 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -15,6 +15,14 @@
 #define CABAC_MAX_BITRATE 160000000
 #define CAVLC_MAX_BITRATE 220000000
 
+/*
+ * ROI delta QP control. Upstream allocates this ID in the UAPI together with a
+ * new S8 control type. A module-only update cannot grow the UAPI, so the same
+ * numeric value is defined here and carried by the existing s32 dynamic array
+ * control type.
+ */
+#define V4L2_CID_MPEG_VIDEO_ROI_MB_DELTA_QP	(V4L2_CID_CODEC_BASE + 658)
+
 static inline bool iris_valid_cap_id(enum platform_inst_fw_cap_type cap_id)
 {
 	return cap_id >= 1 && cap_id < INST_FW_CAP_MAX;
@@ -179,6 +187,8 @@ static enum platform_inst_fw_cap_type iris_get_cap_id(u32 id)
 		return SLICE_MAX_BYTES;
 	case V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MAX_MB:
 		return SLICE_MAX_MB;
+	case V4L2_CID_MPEG_VIDEO_ROI_MB_DELTA_QP:
+		return ROI_PARAMS;
 	default:
 		return INST_FW_CAP_MAX;
 	}
@@ -346,6 +356,8 @@ static u32 iris_get_v4l2_id(enum platform_inst_fw_cap_type cap_id)
 		return V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MAX_BYTES;
 	case SLICE_MAX_MB:
 		return V4L2_CID_MPEG_VIDEO_MULTI_SLICE_MAX_MB;
+	case ROI_PARAMS:
+		return V4L2_CID_MPEG_VIDEO_ROI_MB_DELTA_QP;
 	default:
 		return 0;
 	}
@@ -372,9 +384,20 @@ static int iris_op_s_ctrl(struct v4l2_ctrl *ctrl)
 
 	inst->fw_caps[cap_id].value = ctrl->val;
 
+	if (cap[cap_id].flags & CAP_FLAG_CUSTOM) {
+		cap[cap_id].p_array = ctrl->p_new.p;
+		cap[cap_id].elems = ctrl->new_elems;
+	}
+
 	if (vb2_is_streaming(q)) {
-		if (cap[cap_id].set)
-			cap[cap_id].set(inst, cap_id);
+		if (cap[cap_id].set) {
+			int ret = cap[cap_id].set(inst, cap_id);
+
+			/* A setter that could not arm the frame fails the ioctl
+			 * instead of leaving user space believing it did. */
+			if (ret)
+				return ret;
+		}
 	}
 
 	return 0;
@@ -384,6 +407,20 @@ static const struct v4l2_ctrl_ops iris_ctrl_ops = {
 	.s_ctrl = iris_op_s_ctrl,
 };
 
+static const struct v4l2_ctrl_config roi_mbqp_cfg = {
+	.ops = &iris_ctrl_ops,
+	.id = V4L2_CID_MPEG_VIDEO_ROI_MB_DELTA_QP,
+	.name = "Enc Mb ROI Delta QP",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.dims = { 139264 }, /* Max MBPF = 8192 * 4352 / 256 */
+	.elem_size = sizeof(s32),
+	.min = -31,
+	.max = 30,
+	.def = 0,
+	.step = 1,
+	.flags = V4L2_CTRL_FLAG_DYNAMIC_ARRAY,
+};
+
 int iris_ctrls_init(struct iris_inst *inst)
 {
 	struct platform_inst_fw_cap *cap = &inst->fw_caps[0];
@@ -424,6 +461,10 @@ int iris_ctrls_init(struct iris_inst *inst)
 						      cap[idx].max,
 						      ~(cap[idx].step_or_mask),
 						      cap[idx].value);
+		} else if (cap[idx].flags & CAP_FLAG_CUSTOM) {
+			if (cap[idx].cap_id == ROI_PARAMS)
+				ctrl = v4l2_ctrl_new_custom(&inst->ctrl_handler,
+							    &roi_mbqp_cfg, NULL);
 		} else {
 			ctrl = v4l2_ctrl_new_std(&inst->ctrl_handler,
 						 &iris_ctrl_ops,
@@ -1694,6 +1735,70 @@ int iris_set_slice_count(struct iris_inst *inst, enum platform_inst_fw_cap_type
 					     &hfi_value, sizeof(u32));
 }
 
+int iris_set_roi_params(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
+{
+	struct iris_buffers *buffers = &inst->buffers[BUF_ROIMB_DELTAQP];
+	struct platform_inst_fw_cap *cap = &inst->fw_caps[ROI_PARAMS];
+	u32 width = inst->enc_raw_width;
+	u32 height = inst->enc_raw_height;
+	u32 lcu_size = 16;
+	u32 lcu_width, lcu_height;
+	u32 size;
+	int ret;
+
+	/*
+	 * iris_set_properties() calls every cap setter at STREAMON, including
+	 * this one. No array means the client never set ROI, so there is
+	 * nothing to allocate.
+	 */
+	if (!cap->p_array)
+		return 0;
+
+	if (inst->codec == V4L2_PIX_FMT_HEVC)
+		lcu_size = 32;
+
+	lcu_width = DIV_ROUND_UP(width, lcu_size);
+	lcu_height = DIV_ROUND_UP(height, lcu_size);
+	size = ALIGN(lcu_width, 8) * lcu_height * sizeof(s16);
+	size += 256; /* metadata buffer and payload headers */
+	buffers->size = ALIGN(size, 4096);
+
+	/*
+	 * Delivery mode is a session property, not a per-frame one. A client
+	 * that sets the array before STREAMON subscribed there already; one
+	 * that writes it per picture, which is what a VA client does, reaches
+	 * this path while the queue is streaming, and the subscription has to
+	 * go out before the first map can be queued.
+	 */
+	if (!inst->roi_metadata_delivery) {
+		ret = inst->hfi_session_ops->session_subscribe_metadata_delivery(inst,
+							V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+		if (ret)
+			return ret;
+
+		inst->roi_metadata_delivery = true;
+	}
+
+	return iris_hfi_gen2_session_alloc_roi_metadata_buffer(inst);
+}
+
+int iris_set_metadata_delivery(struct iris_inst *inst, u32 plane)
+{
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+
+	/* Subscribe only when the client has actually enabled ROI. */
+	if (!inst->fw_caps[ROI_PARAMS].p_array)
+		return 0;
+
+	/* ROI cannot work without metadata delivery, so refuse the stream. */
+	if (hfi_ops->session_subscribe_metadata_delivery(inst, plane))
+		return -EINVAL;
+
+	inst->roi_metadata_delivery = true;
+
+	return 0;
+}
+
 int iris_set_properties(struct iris_inst *inst, u32 plane)
 {
 	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.h b/drivers/media/platform/qcom/iris/iris_ctrls.h
