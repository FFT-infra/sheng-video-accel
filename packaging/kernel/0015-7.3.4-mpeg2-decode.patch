--- a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
+++ b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
@@ -55,6 +55,19 @@
 	[IRIS_FMT_AV1] = V4L2_PIX_FMT_AV1,
 };
 
+/*
+ * The SM8550 firmware carries an MPEG-2 decoder that the generic vpu3x
+ * format list does not name. Keep the extra format on this platform so a
+ * device whose firmware refuses codec 6 does not enumerate it.
+ */
+static const u32 iris_fmts_vpu3x_dec_sm8550[] = {
+	[IRIS_FMT_H264] = V4L2_PIX_FMT_H264,
+	[IRIS_FMT_HEVC] = V4L2_PIX_FMT_HEVC,
+	[IRIS_FMT_VP9] = V4L2_PIX_FMT_VP9,
+	[IRIS_FMT_AV1] = V4L2_PIX_FMT_AV1,
+	[IRIS_FMT_MPEG2] = V4L2_PIX_FMT_MPEG2,
+};
+
 static const struct icc_info iris_icc_info_vpu3x[] = {
 	{ "cpu-cfg",    1000, 1000     },
 	{ "video-mem",  1000, 15000000 },
@@ -136,8 +149,8 @@
 	.opp_clk_tbl = iris_opp_clk_table_vpu3x,
 	/* Upper bound of DMA address range */
 	.dma_mask = 0xe0000000 - 1,
-	.inst_iris_fmts = iris_fmts_vpu3x_dec,
-	.inst_iris_fmts_size = ARRAY_SIZE(iris_fmts_vpu3x_dec),
+	.inst_iris_fmts = iris_fmts_vpu3x_dec_sm8550,
+	.inst_iris_fmts_size = ARRAY_SIZE(iris_fmts_vpu3x_dec_sm8550),
 	.inst_caps = &platform_inst_cap_sm8550,
 	.slice_caps = &iris_vpu2_vpu3x_slice_caps,
 	.tz_cp_config_data = tz_cp_config_vpu3,
--- a/drivers/media/platform/qcom/iris/iris_vpu_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_vpu_buffer.c
@@ -720,6 +720,13 @@
 		return hfi_buffer_bin_vp9d(width, height, num_vpp_pipes);
 	else if (inst->codec == V4L2_PIX_FMT_AV1)
 		return hfi_buffer_bin_av1d(width, height, num_vpp_pipes);
+	else if (inst->codec == V4L2_PIX_FMT_MPEG2) {
+		/*
+		 * MPEG-2 has no sizing helper of its own here and is simpler
+		 * than H.264, so the H.264 sizes are an upper bound.
+		 */
+		return hfi_buffer_bin_h264d(width, height, num_vpp_pipes);
+	}
 
 	return 0;
 }
