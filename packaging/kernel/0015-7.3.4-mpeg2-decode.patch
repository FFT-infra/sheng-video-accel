@@ -747,6 +753,9 @@
 			} else if (inst->codec == V4L2_PIX_FMT_AV1) {
 				config_params = fdata->dec_input_config_params_av1;
 				config_params_size = fdata->dec_input_config_params_av1_size;
+			} else if (inst->codec == V4L2_PIX_FMT_MPEG2) {
+				config_params = fdata->dec_input_config_params_mpeg2;
+				config_params_size = fdata->dec_input_config_params_mpeg2_size;
 			} else {
 				return -EINVAL;
 			}
@@ -805,6 +814,9 @@
 	case V4L2_PIX_FMT_AV1:
 		codec = HFI_CODEC_DECODE_AV1;
 		break;
+	case V4L2_PIX_FMT_MPEG2:
+		codec = HFI_CODEC_DECODE_MPEG2;
+		break;
 	}
 
 	iris_hfi_gen2_packet_session_property(inst,
@@ -975,6 +987,11 @@
 		change_param_size =
 			core->iris_firmware_data->dec_input_config_params_av1_size;
 		break;
+	case V4L2_PIX_FMT_MPEG2:
+		change_param = core->iris_firmware_data->dec_input_config_params_mpeg2;
+		change_param_size =
+			core->iris_firmware_data->dec_input_config_params_mpeg2_size;
+		break;
 	}
 
 	payload[0] = HFI_MODE_PORT_SETTINGS_CHANGE;
@@ -1127,6 +1144,11 @@
 			subscribe_prop_size =
 				core->iris_firmware_data->dec_output_prop_av1_size;
 			break;
+		case V4L2_PIX_FMT_MPEG2:
+			subcribe_prop = core->iris_firmware_data->dec_output_prop_mpeg2;
+			subscribe_prop_size =
+				core->iris_firmware_data->dec_output_prop_mpeg2_size;
+			break;
 		}
 	}
 
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
@@ -204,6 +204,7 @@
 	HFI_CODEC_DECODE_HEVC			= 3,
 	HFI_CODEC_ENCODE_HEVC			= 4,
 	HFI_CODEC_DECODE_VP9			= 5,
+	HFI_CODEC_DECODE_MPEG2			= 6,
 	HFI_CODEC_DECODE_AV1			= 7,
 };
 
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -631,6 +631,10 @@
 		inst->fw_caps[PROFILE_AV1].value = subsc_params.profile;
 		inst->fw_caps[LEVEL_AV1].value = subsc_params.level;
 		break;
+	case V4L2_PIX_FMT_MPEG2:
+		inst->fw_caps[PROFILE_MPEG2].value = subsc_params.profile;
+		inst->fw_caps[LEVEL_MPEG2].value = subsc_params.level;
+		break;
 	}
 
