+		subsc_params->level = inst->fw_caps[LEVEL_MPEG2].value;
+		break;
 	}
 
 	subsc_params->pic_order_cnt = inst->fw_caps[POC].value;
--- a/drivers/media/platform/qcom/iris/iris_instance.h
+++ b/drivers/media/platform/qcom/iris/iris_instance.h
@@ -22,6 +22,7 @@
 	IRIS_FMT_HEVC,
 	IRIS_FMT_VP9,
 	IRIS_FMT_AV1,
+	IRIS_FMT_MPEG2,
 };
 
 enum iris_fmt_type_cap {
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -210,6 +210,13 @@
 	SLICE_MODE,
 	SLICE_MAX_BYTES,
 	SLICE_MAX_MB,
+	/*
+	 * Appended rather than grouped with the other profiles: the caps
+	 * table is indexed by this enum, so a new entry only takes the next
+	 * free index.
+	 */
