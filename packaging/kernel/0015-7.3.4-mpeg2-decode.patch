 };
 
+static const u32 sm8550_vdec_subscribe_output_properties_mpeg2[] = {
+	HFI_PROP_PICTURE_TYPE,
+};
+
 static const u32 sm8550_dec_ip_int_buf_tbl[] = {
 	BUF_BIN,
 	BUF_COMV,
@@ -2103,6 +2141,10 @@
 		sm8550_vdec_input_config_param_av1,
