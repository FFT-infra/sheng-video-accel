+	.dec_output_prop_mpeg2_size =
+		ARRAY_SIZE(sm8550_vdec_subscribe_output_properties_mpeg2),
 
 	.dec_ip_int_buf_tbl = sm8550_dec_ip_int_buf_tbl,
 	.dec_ip_int_buf_tbl_size = ARRAY_SIZE(sm8550_dec_ip_int_buf_tbl),
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
@@ -422,6 +422,9 @@
 	case V4L2_PIX_FMT_AV1:
 		profile = inst->fw_caps[PROFILE_AV1].value;
 		break;
+	case V4L2_PIX_FMT_MPEG2:
+		profile = inst->fw_caps[PROFILE_MPEG2].value;
+		break;
 	}
 
 	inst_hfi_gen2->src_subcr_params.profile = profile;
@@ -454,6 +457,9 @@
 	case V4L2_PIX_FMT_AV1:
 		level = inst->fw_caps[LEVEL_AV1].value;
 		break;
+	case V4L2_PIX_FMT_MPEG2:
+		level = inst->fw_caps[LEVEL_MPEG2].value;
+		break;
 	}
 
