From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xinyang <xinyang@localhost>
Date: Tue, 18 Nov 2026 12:00:00 +0800
Subject: [PATCH] media: iris: allocate CAPTURE buffers from system memory (7.3.4)

The decoder's CAPTURE queue uses vb2_dma_contig_memops, so every pool frame
comes from the device's contiguous DMA carve-out. On SM8550 that carve-out is
768 MiB and holds the firmware's DPB and scratch buffers as well, which is why
an 8K pool stops at eight frames while a Direct target needs fifteen and
falls back to Copy.

The video-codec node is already behind the SMMU (its iommus property attaches
it to an IOMMU group at boot), and the firmware already consumes translated
addresses for every internal buffer, so the physical layout of a CAPTURE frame
does not have to be contiguous. Add a capture_sg module parameter that selects
vb2_dma_sg_memops for the decoder's CAPTURE queue; the buffer's device address
is then taken from the mapped scatter list when the buffer is queued, because
the scatter-gather allocator only has one after the DMA mapping. The encoder's
queues, the OUTPUT queue and every internal buffer keep the contiguous
allocator.

Default off: the parameter is an experiment until a target run decodes at 8K
from system memory and the memory-budget policy that goes with it is settled.
---
--- a/drivers/media/platform/qcom/iris/iris_vidc.c
+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -8,6 +8,7 @@
 #include <media/v4l2-ioctl.h>
 #include <media/v4l2-mem2mem.h>
 #include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-dma-sg.h>
 
 #include "iris_ctrls.h"
 #include "iris_vidc.h"
@@ -23,6 +24,11 @@
 #define STEP_WIDTH 1
 #define STEP_HEIGHT 1
 
+static bool capture_sg;
+module_param(capture_sg, bool, 0444);
+MODULE_PARM_DESC(capture_sg,
+	"Allocate CAPTURE buffers from system memory and map them through the IOMMU");
+
 static void iris_v4l2_fh_init(struct iris_inst *inst, struct file *filp)
 {
 	if (inst->domain == ENCODER)
@@ -118,7 +124,8 @@
 	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
 	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
 	dst_vq->ops = inst->core->iris_vb2_ops;
-	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->mem_ops = capture_sg && inst->domain == DECODER ?
+		&vb2_dma_sg_memops : &vb2_dma_contig_memops;
 	dst_vq->drv_priv = inst;
 	dst_vq->buf_struct_size = sizeof(struct iris_buffer);
 	dst_vq->min_reqbufs_allocation = MIN_BUFFERS;
--- a/drivers/media/platform/qcom/iris/iris_vb2.c
+++ b/drivers/media/platform/qcom/iris/iris_vb2.c
@@ -3,7 +3,9 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/scatterlist.h>
 #include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-dma-sg.h>
 #include <media/v4l2-event.h>
 #include <media/v4l2-mem2mem.h>
 
@@ -90,7 +92,11 @@
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb2);
 	struct iris_buffer *buf = to_iris_buffer(vbuf);
 
-	buf->device_addr = vb2_dma_contig_plane_dma_addr(vb2, 0);
+	/* The scatter-gather allocator has no address until the buffer is
+	 * queued, so its address is taken in iris_vb2_buf_queue.
+	 */
+	if (vb2->vb2_queue->mem_ops != &vb2_dma_sg_memops)
+		buf->device_addr = vb2_dma_contig_plane_dma_addr(vb2, 0);
 
 	return 0;
 }
@@ -288,6 +294,7 @@
 {
 	static const struct v4l2_event eos = { .type = V4L2_EVENT_EOS };
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb2);
+	struct iris_buffer *buf = to_iris_buffer(vbuf);
 	struct v4l2_m2m_ctx *m2m_ctx;
 	struct iris_inst *inst;
 	int ret = 0;
@@ -303,6 +310,12 @@
 	if (vbuf->field == V4L2_FIELD_ANY)
 		vbuf->field = V4L2_FIELD_NONE;
 
+	if (vb2->vb2_queue->mem_ops == &vb2_dma_sg_memops) {
+		struct sg_table *sgt = vb2_dma_sg_plane_desc(vb2, 0);
+
+		buf->device_addr = sgt ? sg_dma_address(sgt->sgl) : 0;
+	}
+
 	m2m_ctx = inst->m2m_ctx;
 
 	if (!vb2->planes[0].bytesused && V4L2_TYPE_IS_OUTPUT(vb2->type)) {
--- a/drivers/media/platform/qcom/iris/Kconfig
+++ b/drivers/media/platform/qcom/iris/Kconfig
@@ -9,6 +9,7 @@
 	select QCOM_PAS
 	select QCOM_UBWC_CONFIG if ARCH_QCOM && QCOM_SMEM
 	select VIDEOBUF2_DMA_CONTIG
+	select VIDEOBUF2_DMA_SG
 	help
 	  This is a V4L2 driver for Qualcomm iris video accelerator
 	  hardware. It accelerates decoding operations on various
