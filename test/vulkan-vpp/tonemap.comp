// SPDX-License-Identifier: MIT
//
// HDR10 to SDR tone mapping for the VA video processor: a P010 surface
// (BT.2020 primaries, PQ transfer, limited range) to an NV12 surface (BT.709
// primaries, BT.709 OETF, limited range). This is the kernel behind
// VAProcFilterHighDynamicRangeToneMapping with VA_TONE_MAPPING_HDR_TO_SDR,
// which is what `tonemap_vaapi=format=nv12` asks a driver for.
//
// There is no byte-exact reference for a tone curve, so the contract is the
// pipeline itself, written down here and mirrored by the gate's CPU oracle:
//
//   1. limited-range BT.2020 non-constant-luminance YCbCr to R'G'B' PQ codes
//   2. PQ EOTF to cd/m²
//   3. ITU-R BT.2390 EETF (the Hermite shoulder) toward a 100 cd/m² SDR peak,
//      applied as one gain on the largest channel so hue is preserved
//   4. linear BT.2020 to BT.709, out-of-gamut negatives desaturated at
//      constant BT.709 luminance
//   5. BT.709 OETF, then limited-range 8-bit Y'CbCr
//
// The source peak comes from the HDR10 metadata in the pipeline's filter
// buffer; the target is the 100 cd/m² reference white of the SDR standard.
//
// Each invocation owns a 4x2 destination block: two luma words (four pixels
// each) and one chroma word (two pairs, each averaged over the 2x2 block it
// covers). No two invocations write the same word.

#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) readonly buffer Src { uint s[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Dst { uint d[]; };
layout(push_constant) uniform Params {
    uint src_stride, src_uv, dst_stride, dst_uv;
    uint src_y, dst_y;
    uint width, height;
    // PQ code of the source peak, and the BT.2390 knee in the space where the
    // input is normalised by that peak. The host computes both from the HDR10
    // metadata so the shader does no metadata parsing.
    float src_pq, knee, max_lum;
} p;

// PQ constants (SMPTE ST 2084).
const float M1 = 0.1593017578125;
const float M2 = 78.84375;
const float C1 = 0.8359375;
const float C2 = 18.8515625;
const float C3 = 18.6875;

// 100 cd/m² SDR reference white, and the luma coefficients both standards
// share.
const float SDR_WHITE = 100.0;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float pq_encode(float nits)
{
    float t = pow(max(nits, 0.0) / 10000.0, M1);
    return pow((C1 + C2 * t) / (1.0 + C3 * t), M2);
}

vec3 pq_decode(vec3 code)
{
    vec3 t = pow(clamp(code, 0.0, 1.0), vec3(1.0 / M2));
    return 10000.0 * pow(max(t - vec3(C1), vec3(0.0)) / (vec3(C2) - vec3(C3) * t),
                    vec3(1.0 / M1));
}

float bt709_oetf(float x)
{
    return x < 0.018 ? 4.5 * x : 1.099 * pow(x, 0.45) - 0.099;
}

// ITU-R BT.2390 Annex 2: a cubic Hermite shoulder from the knee to the
// target, flat at the knee and ending at `max_lum`. Inputs are PQ codes
// normalised by the source peak.
float eetf(float e)
{
    e = clamp(e, 0.0, 1.0);
    if (e <= p.knee)
        return e;
    float t = (e - p.knee) / (1.0 - p.knee);
    float t2 = t * t;
    float t3 = t2 * t;
    return (2.0 * t3 - 3.0 * t2 + 1.0) * p.knee + (t3 - 2.0 * t2 + t) * (1.0 - p.knee)
        + (-2.0 * t3 + 3.0 * t2) * p.max_lum;
}

// One 10-bit sample from a 16-bit little-endian word with the ten bits at the
// top, as a 0..1023 code value.
float sample10(uint off)
{
    return float((s[off >> 2] >> ((off & 3u) << 3)) & 0xffffu) / 64.0;
}

vec3 decode_bt2020(float y10, float u10, float v10)
{
    float y = (y10 - 64.0) / 876.0;
    float cb = (u10 - 512.0) / 896.0;
    float cr = (v10 - 512.0) / 896.0;
    float r = y + 1.4746 * cr;
    float b = y + 1.8814 * cb;
    float g = (y - 0.2627 * r - 0.0593 * b) / 0.6780;
    return vec3(r, g, b);
}

// One pixel: PQ codes in, tone-mapped BT.709 OETF values out.
vec3 tone_pixel(float y10, float u10, float v10)
{
    vec3 nits = pq_decode(decode_bt2020(y10, u10, v10));
    float peak = max(max(nits.x, nits.y), nits.z);
    if (peak <= 0.0)
        return vec3(0.0);
    float mapped = pq_decode(vec3(eetf(pq_encode(peak) / p.src_pq) * p.src_pq)).x;
    vec3 rgb = nits * (mapped / peak / SDR_WHITE);
    // Linear BT.2020 to BT.709.
    rgb = vec3(dot(rgb, vec3(1.660491, -0.587641, -0.072850)),
        dot(rgb, vec3(-0.124550, 1.132900, -0.008349)),
        dot(rgb, vec3(-0.018151, -0.100579, 1.118730)));
    // Desaturate out-of-gamut negatives at constant BT.709 luminance rather
    // than clipping the channel, which would shift hue.
    float luma = max(dot(rgb, LUMA), 0.0);
    float negative = max(-min(min(rgb.x, rgb.y), rgb.z), 0.0);
    rgb = (rgb + vec3(negative)) * (luma / max(luma + negative, 1e-20));
    rgb = clamp(rgb, 0.0, 1.0);
    return vec3(bt709_oetf(rgb.x), bt709_oetf(rgb.y), bt709_oetf(rgb.z));
}

float limited8(float normalized)
{
    return clamp(round(16.0 + 219.0 * normalized), 0.0, 255.0);
}

float limited_chroma(float normalized)
{
    return clamp(round(128.0 + 224.0 * normalized), 0.0, 255.0);
}

void main()
{
    uint x = gl_GlobalInvocationID.x * 4u;
    uint y = gl_GlobalInvocationID.y * 2u;
    if (x >= p.width || y >= p.height)
        return;

    // The two chroma pairs this block covers, one per 2x2 luma block.
    uint uv_off = p.src_uv + (y >> 1) * p.src_stride + x * 2u;
    float u[2] = { sample10(uv_off), sample10(uv_off + 4u) };
    float v[2] = { sample10(uv_off + 2u), sample10(uv_off + 6u) };
    float cb[2] = { 0.0, 0.0 };
    float cr[2] = { 0.0, 0.0 };
    float n[2] = { 0.0, 0.0 };

    for (uint row = 0u; row < 2u; ++row) {
        uint yy = y + row;
        uint base = p.src_y + yy * p.src_stride + x * 2u;
        uint packed = 0u;
        for (uint col = 0u; col < 4u; ++col) {
            uint xx = x + col;
            if (xx >= p.width)
                break;
            uint pair = col >> 1;
            vec3 rgb = tone_pixel(sample10(base + col * 2u), u[pair], v[pair]);
            float luma = dot(rgb, LUMA);
            cb[pair] += (rgb.z - luma) / 1.8556;
            cr[pair] += (rgb.x - luma) / 1.5748;
            n[pair] += 1.0;
            packed |= uint(limited8(luma)) << (col * 8u);
        }
        d[(p.dst_y + yy * p.dst_stride + x) >> 2] = packed;
    }

    // A destination column with no visible 2x2 block (width not a multiple of
    // four) still occupies the padding after the last visible pair; keep it
    // at neutral instead of dividing by zero.
    uint word = 0u;
    for (uint pair = 0u; pair < 2u; ++pair) {
        float k = n[pair] > 0.0 ? 1.0 / n[pair] : 0.0;
        uint uu = uint(limited_chroma(cb[pair] * k));
        uint vv = uint(limited_chroma(cr[pair] * k));
        word |= (uu | (vv << 8u)) << (pair * 16u);
    }
    d[(p.dst_uv + (y >> 1) * p.dst_stride + x) >> 2] = word;
}
