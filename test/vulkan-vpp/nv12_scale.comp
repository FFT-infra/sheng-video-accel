// SPDX-License-Identifier: MIT
//
// NV12 nearest-neighbour scale (optionally from a crop, optionally rotated)
// for the VA video processor. The two DMA-BUFs
// are bound as flat uint[] storage buffers and every address (stride, luma and
// chroma offsets, source and destination geometry, rotation) comes from push
// constants, so this is the same kernel the driver dispatches, not a shader
// with one test size baked in.
//
// The sample position is swscale's point map, so a client that swaps
// `scale=WxH:flags=neighbor` for `scale_vaapi=w=W:h=H` gets the same pixels at
// any ratio:
//
//     xInc = ((src << 16) + (dst >> 1)) / dst      (rounded 16.16 step)
//     src_index(i) = (i * xInc + (xInc >> 1)) >> 16
//
// (libswscale/utils.c initFilter, SWS_POINT with filterSize 1, and the
// lumXInc/chrXInc rounding in sws_init_context; verified byte-exact against
// the host `scale` filter over the ratio matrix in nv12_scale_gate.sh.)
//
// Rotation follows the VA pipeline order: the source is rotated clockwise
// first, then scaled to fill the output. So the point map runs on the rotated
// size and `unrotate` walks each destination point back to the source. A
// quarter turn makes the two planes transpose too, which is why the map is
// applied to the chroma plane with its own half-size geometry rather than
// derived from the luma coordinate. VA puts mirroring after the rotation, so
// the flip is applied to the rotated coordinates before they are taken back,
// with the rotated size rather than the source size.
//
// Each invocation owns one 32-bit destination word, so no two invocations
// write the same word and a per-pixel oracle is meaningful instead of a race
// that happens to pass. A luma word holds four pixels of one row; a chroma
// word holds two (u,v) pairs. No 16-bit storage extension is needed. The plane
// base and stride are 4-byte aligned by the CAPTURE layout (128-byte pitch,
// page-aligned data offset), which is what makes a word write legal.

#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) readonly buffer Src { uint s[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Dst { uint d[]; };
layout(push_constant) uniform Params {
    uint src_stride, src_uv, dst_stride, dst_uv;
    uint src_y, dst_y;
    // Crop origin in source pixels. VA hands a surface region to the
    // processor, and the sampled rectangle starts there; both coordinates
    // are even because a 4:2:0 chroma sample covers two luma columns.
    uint src_x, src_row;
    uint src_w, src_h, dst_w, dst_h;
    // Clockwise quarter turns: VA_ROTATION_NONE/90/180/270 as 0/1/2/3.
    uint rot;
    // VA_MIRROR_HORIZONTAL as bit 0 and VA_MIRROR_VERTICAL as bit 1, applied
    // after the rotation.
    uint mirror;
} p;

uint src_byte(uint off)
{
    uint w = s[off >> 2];
    return (w >> ((off & 3u) << 3)) & 255u;
}

// 16.16 source step per destination sample, rounded to nearest like swscale.
uint step(uint src, uint dst)
{
    return ((src << 16) + (dst >> 1)) / dst;
}

uint pick(uint i, uint inc)
{
    return (i * inc + (inc >> 1)) >> 16;
}

// Size of a w x h plane after the rotation. A quarter turn transposes it.
uvec2 rotated(uint w, uint h)
{
    return (p.rot & 1u) != 0u ? uvec2(h, w) : uvec2(w, h);
}

// The point (rx, ry) of the rotated plane as the mirroring leaves it. `size`
// is the rotated plane's size, because VA mirrors after rotating.
uvec2 mirror_at(uvec2 at, uvec2 size)
{
    if ((p.mirror & 1u) != 0u)
        at.x = size.x - 1u - at.x;
    if ((p.mirror & 2u) != 0u)
        at.y = size.y - 1u - at.y;
    return at;
}

// The source point behind (rx, ry) of the rotated plane. A clockwise quarter
// turn sends the source top-left corner to the top-right, 180 degrees to the
// bottom-right and 270 to the bottom-left, so undoing it means reading the
// rotated coordinates in that corner's order.
uvec2 unrotate(uint rx, uint ry, uint w, uint h)
{
    if (p.rot == 1u)
        return uvec2(ry, h - 1u - rx);
    if (p.rot == 2u)
        return uvec2(w - 1u - rx, h - 1u - ry);
    if (p.rot == 3u)
        return uvec2(w - 1u - ry, rx);
    return uvec2(rx, ry);
}

void main()
{
    uint word = gl_GlobalInvocationID.x;
    uint words = (p.dst_w + 3u) >> 2;
    if (word >= words)
        return;
    // Luma rows first, then the half-height chroma plane: one dispatch covers
    // both buffers, and each row indexes the same word count.
    uint row = gl_GlobalInvocationID.y;
    if (row >= p.dst_h + (p.dst_h >> 1))
        return;

    if (row < p.dst_h) {
        uvec2 r = rotated(p.src_w, p.src_h);
        uint hx = step(r.x, p.dst_w);
        uint hy = step(r.y, p.dst_h);
        uint ry = pick(row, hy);
        uint packed = 0u;
        for (uint k = 0u; k < 4u; ++k) {
            uint dx = word * 4u + k;
            // Columns past the visible width land in the row padding; clamp so
            // the read stays inside the source plane.
            uvec2 rp = mirror_at(uvec2(pick(min(dx, p.dst_w - 1u), hx), ry), r);
            uvec2 at = unrotate(rp.x, rp.y, p.src_w, p.src_h);
            packed |= src_byte(p.src_y + (p.src_row + at.y) * p.src_stride + p.src_x + at.x) << (k * 8u);
        }
        d[(p.dst_y + row * p.dst_stride + word * 4u) >> 2] = packed;
    } else {
        uint cy = row - p.dst_h;
        uint cw = p.src_w >> 1;
        uint ch = p.src_h >> 1;
        uint dw = p.dst_w >> 1;
        uvec2 r = rotated(cw, ch);
        uint hx = step(r.x, dw);
        uint hy = step(r.y, p.dst_h >> 1);
        uint ry = pick(cy, hy);
        // The crop origin is even, so the chroma origin is exactly src_x/2
        // pairs — that is, src_x bytes into the interleaved row.
        uint base = p.src_uv + (p.src_row >> 1) * p.src_stride + p.src_x;
        uint packed = 0u;
        for (uint k = 0u; k < 2u; ++k) {
            uint cx = word * 2u + k;
            uvec2 rp = mirror_at(uvec2(pick(min(cx, dw - 1u), hx), ry), r);
            uvec2 at = unrotate(rp.x, rp.y, cw, ch);
            uint off = base + at.y * p.src_stride + at.x * 2u;
            packed |= src_byte(off) << (k * 16u);
            packed |= src_byte(off + 1u) << (k * 16u + 8u);
        }
        d[(p.dst_uv + cy * p.dst_stride + word * 4u) >> 2] = packed;
    }
}
